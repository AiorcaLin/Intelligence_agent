# ===================== Database =====================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intel_engine
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/intel_engine
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ===================== Auth =====================
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ===================== LLM =====================
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
CLAUDE_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# ===================== Embedding =====================
# 服务商切换：只需修改下面 4 个变量，代码无需改动
#
# [默认] OpenAI 官方（香港不可用）
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIMENSIONS=1536
#   EMBEDDING_BASE_URL=
#   EMBEDDING_API_KEY=       # 留空则用 OPENAI_API_KEY
#
# [推荐·香港] OpenRouter（你已有账号）→ 切换到 OpenRouter 的嵌入模型
#   EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
#   EMBEDDING_API_KEY=sk-or-xxx          # 你的 OpenRouter Key
#   EMBEDDING_MODEL=qwen/qwen3-embedding-4b
#   EMBEDDING_DIMENSIONS=2560
#
# [备选] SiliconFlow（国内可付费）
#   EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#   EMBEDDING_API_KEY=sk-xxx
#   EMBEDDING_MODEL=BAAI/bge-m3
#   EMBEDDING_DIMENSIONS=1024
#
# [备选] 阿里云 DashScope（国内可付费）
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBEDDING_API_KEY=sk-xxx
#   EMBEDDING_MODEL=text-embedding-v3
#   EMBEDDING_DIMENSIONS=1024
#
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ===================== Credits Config =====================
PLATFORM_MULTIPLIER=15
CREDIT_TO_RMB_RATE=0.01
DAILY_FREE_CREDITS=50

# ===================== Social Media =====================
TWITTER_API_KEY=xxx
TWITTER_API_SECRET=xxx
TWITTER_ACCESS_TOKEN=xxx
TWITTER_ACCESS_TOKEN_SECRET=xxx
TELEGRAM_BOT_TOKEN=xxx

# ===================== Payment =====================
ALIPAY_APP_ID=xxx
ALIPAY_PRIVATE_KEY=xxx
ALIPAY_PUBLIC_KEY=xxx
WECHAT_APP_ID=xxx
WECHAT_MCH_ID=xxx
WECHAT_API_KEY=xxx

# ===================== Storage =====================
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=intel-media

# ===================== App =====================
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000

# ===================== Celery =====================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
